# ───────────────────────────────────────────────
# MCP Sales Agent — Environment Configuration
# ───────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Demo mode works without any of these — just cp .env.example .env and run.

# ─── LLM Provider ───
# Required for live analysis mode (demo mode works without this)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Database ───
# Required for persistence in production (demo uses in-memory cache)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/mcp_sales_agent

# ─── MCP Transport ───
# Set to 'stdio' for CLI integration, 'sse' for HTTP streaming
# Default: sse
MCP_TRANSPORT=sse

# ─── n8n Integration Orchestrator ───
# All CRM/call/email integrations are managed through n8n workflows.
# When unset, the app falls back to zero-config demo mode.
# n8n webhook base URL (e.g., https://n8n.yourdomain.com/webhook)
N8N_WEBHOOK_URL=
# Optional n8n API key for webhook authentication
N8N_API_KEY=

# ─── Webhook Secrets ───
# Set these to verify incoming webhooks from call recorders.
# When unset, webhooks are accepted without verification (dev mode).
GONG_WEBHOOK_SECRET=
FATHOM_WEBHOOK_SECRET=
FIREFLIES_WEBHOOK_SECRET=

# ─── Salesforce ───
# OAuth2 credentials from your Salesforce Connected App
# Required for pipeline update tool (via n8n workflow)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:3000/api/auth/salesforce/callback

# ─── HubSpot ───
# Private app token from HubSpot Settings > Integrations > Private Apps
# Required for HubSpot pipeline tool (via n8n workflow)
HUBSPOT_PRIVATE_APP_TOKEN=

# ─── Gong ───
# API key from Gong Settings > API
# Required for call ingestion tool (via n8n workflow)
GONG_API_KEY=

# ─── Slack ───
# Webhook URL for notifications (via n8n workflow)
# Get it at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ─── Gmail / Outlook ───
# OAuth2 credentials for follow-up draft/send tool (via n8n workflow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
